{
  "name": "senui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm check:components && pnpm format:check",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0 && stylelint \"packages/react/src/**/*.css\" --max-warnings 0 --allow-empty-input",
    "sync:wcag": "node scripts/sync-wcag.mjs",
    "check:components": "node scripts/check-a11y-contracts.mjs && node scripts/check-component-css.mjs && node scripts/check-dist-css.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r build",
    "changeset": "changeset",
    "test:gate": "pnpm build && pnpm --filter docs build-storybook && pnpm --filter docs exec playwright test"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
