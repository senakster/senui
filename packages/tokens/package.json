{
  "name": "@senakster/senui-tokens",
  "version": "1.0.0",
  "description": "Design tokens for senui: CSS custom properties and a typed JS map.",
  "license": "MIT",
  "homepage": "https://senakster.github.io/senui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senakster/senui.git",
    "directory": "packages/tokens"
  },
  "bugs": "https://github.com/senakster/senui/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node sd.config.mjs && tsdown",
    "prepack": "node ../../scripts/copy-license.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "colorjs.io": "0.5.2",
    "publint": "0.3.25",
    "style-dictionary": "5.6.1",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
