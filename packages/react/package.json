{
  "name": "@senakster/senui",
  "version": "0.0.0",
  "description": "senui React components: plain CSS on design tokens, accessible by contract.",
  "license": "MIT",
  "homepage": "https://senakster.github.io/senui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senakster/senui.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/senakster/senui/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/styles/index.css",
    "./styles/*.css": "./dist/components/*/*.css",
    "./components.json": "./dist/components.json",
    "./llms.txt": "./dist/llms.txt",
    "./llms-full.txt": "./dist/llms-full.txt",
    "./USAGE.md": "./dist/USAGE.md",
    "./docs/*.md": "./dist/docs/*.md",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../scripts/copy-license.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@senakster/senui-tokens": "workspace:^",
    "react": "^18.3 || ^19",
    "react-dom": "^18.3 || ^19"
  },
  "devDependencies": {
    "@senakster/senui-tokens": "workspace:^",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.4",
    "axe-core": "4.14.0",
    "jsdom": "30.1.2",
    "playwright": "1.64.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.2",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
